# Module 9 Homework — AI Report Validation System
#
# The pipeline searches for a .env file in this order:
#   1. ./.env                                                 (this folder)
#   2. ../acti_multi_agent/research-agent/carpool_v4/.env     (carpool_v4)
#   3. ../acti_multi_agent/research-agent/.env                (research-agent)
#
# Copy this file to .env and fill in your key, OR symlink an existing .env:
#   ln -s ../acti_multi_agent/research-agent/carpool_v4/.env .env

# Required: Anthropic API key for Claude (used for both report generation and reviewer scoring)
ANTHROPIC_API_KEY=

# Model selection (defaults are set in src/config.py)
# Report generation uses MODEL_FAST; reviewer scoring uses MODEL_DEEP.
MODEL_FAST=claude-sonnet-4-5-20250929
MODEL_DEEP=claude-opus-4-5

# Sample size for the experiment (default 12 reports per prompt)
N_VARIANTS=12

# Generation temperature (higher = more variation across reports; default 0.7)
GEN_TEMPERATURE=0.7

# Reviewer temperature (lower = more consistent scoring; default 0.0)
REVIEW_TEMPERATURE=0.0
