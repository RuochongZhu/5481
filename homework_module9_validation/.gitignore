# Override parent .gitignore for this homework folder:
# We need to track the CSV results, but NEVER track the real .env file.

# Re-include CSVs (parent .gitignore drops all *.csv)
!*.csv
!**/*.csv

# Hard-ignore the real .env (defense in depth on top of parent rule)
.env

# Python bytecode
__pycache__/
*.pyc
